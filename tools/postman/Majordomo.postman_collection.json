              "raw": "{\n  \"name\": \"US100 paper {{$timestamp}}\",\n  \"description\": \"Job di prova dal playground Postman\",\n  \"parameters\": {\n    \"universe\": {\n      \"epics\": [\n        \"US100\"\n      ],\n      \"resolution\": \"MINUTE_15\",\n      \"horizonSteps\": 8,\n      \"contextLength\": 512\n    },\n    \"model\": {\n      \"family\": \"timesfm-2.5\",\n      \"quantiles\": [\n        0.1,\n        0.5,\n        0.9\n      ]\n    },\n    \"signal\": {\n      \"strategy\": \"ExpectedReturnThreshold\",\n      \"minConfidence\": 0.6,\n      \"expectedReturnThresholdPct\": 0.2\n    },\n    \"risk\": {\n      \"profile\": \"conservative\",\n      \"allocation\": {\n        \"amount\": 10000,\n        \"currency\": \"EUR\"\n      },\n      \"riskPerTradePct\": 0.5,\n      \"maxDailyLossPct\": 2,\n      \"maxDrawdownPct\": 10,\n      \"maxLeverage\": 5,\n      \"maxOpenPositions\": 3,\n      \"stopLoss\": {\n        \"method\": \"quantileBand\",\n        \"multiplier\": 1.0,\n        \"minDistancePoints\": 5\n      }\n    },\n    \"operationalLimits\": {\n      \"maxOrdersPerDay\": 10\n    },\n    \"mode\": \"paper\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
